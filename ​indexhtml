!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Para mi Enojona Preferida | Xiomara ❤️</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Montserrat:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        weddingGold: '#D4AF37',
                        weddingRose: '#F4E0E5',
                        weddingBlush: '#FFF5F6',
                        weddingWine: '#7A1C31',
                        weddingChampagne: '#F7E7CE'
                    },
                    fontFamily: {
                        cursive: ['Great Vibes', 'cursive'],
                        serif: ['Playfair Display', 'serif'],
                        sans: ['Montserrat', 'sans-serif']
                    }
                }
            }
        }
    </script>

    <style>
        /* Custom animations & wedding styling */
        @keyframes float {
            0% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-10px) rotate(3deg); }
            100% { transform: translateY(0px) rotate(0deg); }
        }
        @keyframes pulseGlow {
            0%, 100% { box-shadow: 0 0 15px rgba(212, 175, 55, 0.4); }
            50% { box-shadow: 0 0 30px rgba(212, 175, 55, 0.8); }
        }
        .float-anim {
            animation: float 4s ease-in-out infinite;
        }
        .gold-glow {
            animation: pulseGlow 3s infinite;
        }
        .gold-border {
            border: 2px solid #D4AF37;
        }
        .gold-gradient-text {
            background: linear-gradient(135deg, #BF953F, #FCF6BA, #B38728, #FBF5B7, #AA771C);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(212, 175, 55, 0.3);
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #FFF5F6;
        }
        ::-webkit-scrollbar-thumb {
            background: #D4AF37;
            border-radius: 10px;
        }
        /* Canvas background overlay */
        #petalCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 50;
        }
    </style>
</head>
<body class="bg-weddingBlush text-gray-800 font-sans antialiased relative overflow-x-hidden">

    <!-- Petals & Stars Animation Canvas -->
    <canvas id="petalCanvas"></canvas>

    <!-- LOCKED SCREEN / COUNTDOWN GATEKEEPER (Stays visible until Dec 31, 2026 @ 11:56 PM) -->
    <div id="lockScreen" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-lg transition-opacity duration-1000">
        <div class="glass-card max-w-lg w-full rounded-3xl p-8 text-center gold-border shadow-2xl relative overflow-hidden">
            <!-- Decorative Glows -->
            <div class="absolute -top-12 -left-12 w-32 h-32 bg-weddingGold/20 rounded-full blur-2xl"></div>
            <div class="absolute -bottom-12 -right-12 w-32 h-32 bg-weddingWine/20 rounded-full blur-2xl"></div>
            
            <div class="inline-block p-4 rounded-full bg-weddingWine/10 border border-weddingGold/40 mb-4 gold-glow">
                <i class="fa-solid fa-lock text-4xl text-weddingGold"></i>
            </div>

            <h2 class="font-serif text-3xl sm:text-4xl font-bold text-weddingWine mb-2">Sorpresa Especial</h2>
            <p class="font-cursive text-3xl text-weddingGold mb-4">Para Xiomara ❤️</p>
            
            <p class="text-sm sm:text-base text-gray-700 italic mb-6">
                "Aún no es el momento, mi niña hermosa... Esta sorpresa se desbloqueará exactamente a las <strong>11:56 PM</strong> del 31 de Diciembre."
            </p>

            <!-- Countdown Timer Box -->
            <div class="grid grid-cols-4 gap-2 sm:gap-3 my-6">
                <div class="bg-white/90 p-3 rounded-2xl border border-weddingGold/40 shadow-sm">
                    <span id="lockDays" class="font-serif text-2xl sm:text-3xl font-bold text-weddingWine block">00</span>
                    <span class="text-[10px] text-gray-500 font-semibold uppercase">Días</span>
                </div>
                <div class="bg-white/90 p-3 rounded-2xl border border-weddingGold/30 shadow-sm">
                    <span id="lockHours" class="font-serif text-2xl sm:text-3xl font-bold text-weddingWine block">00</span>
                    <span class="text-[10px] text-gray-500 font-semibold uppercase">Horas</span>
                </div>
                <div class="bg-white/90 p-3 sm:p-4 rounded-2xl border border-weddingGold/30 shadow-sm">
                    <span id="lockMinutes" class="font-serif text-2xl sm:text-3xl font-bold text-weddingWine block">00</span>
                    <span class="text-[10px] text-gray-500 font-semibold uppercase">Min</span>
                </div>
                <div class="bg-white/90 p-3 sm:p-4 rounded-2xl border border-weddingGold/30 shadow-sm">
                    <span id="lockSeconds" class="font-serif text-2xl sm:text-3xl font-bold text-weddingWine block">00</span>
                    <span class="text-[10px] text-gray-500 font-semibold uppercase">Seg</span>
                </div>
            </div>
